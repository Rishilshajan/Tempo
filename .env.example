# Copy to .env.local and supply keys from your Clerk application.
# Use development keys locally; use production keys on your deployed domain.
# Leave values empty until configured. Never commit real keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard

# Public endpoints. Set CLERK_FRONTEND_API_URL on the Convex deployment too.
NEXT_PUBLIC_CONVEX_URL=https://giddy-corgi-8.convex.cloud
CLERK_FRONTEND_API_URL=https://noble-ferret-167.clerk.accounts.dev
