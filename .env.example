# ----------------------------------------------------------------------------
# Tempo - environment variables
# Copy this file to `.env` and fill in your Supabase credentials.
# ----------------------------------------------------------------------------

# Supabase Postgres connection string (used by Drizzle ORM).
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI.
# Use the "Session" pooler (port 5432) or the pooler on 6543 for serverless.
# Example: postgresql://postgres.xxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Supabase project API (optional for now; used later for realtime/storage).
# Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"

# Claude API (used later for natural-language task parsing + briefings).
ANTHROPIC_API_KEY="[YOUR-ANTHROPIC-API-KEY]"

# Secret guarding the rollforward cron endpoint (/api/cron/rollforward).
CRON_SECRET="[A-LONG-RANDOM-STRING]"

# App timezone (IANA) for the "today" day boundary. REQUIRED on a UTC host
# like Vercel so rollforward/briefing use your local day, not UTC.
# Leave unset in local dev to use the machine timezone. Example: Asia/Kolkata
APP_TIMEZONE=""
